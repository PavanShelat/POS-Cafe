# Shared (used by client + server)
VITE_SUPABASE_URL=

# Client
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=

# Server
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# One-time secret for creating the first admin from the login page.
# Leave empty (setup disabled) once an admin exists.
ADMIN_SETUP_SECRET=
# Optional (not currently used by the server)
SUPABASE_JWT_SECRET=
GROQ_API_KEY=
GROQ_MODEL=
# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# POS QR Payment
POS_QR_PAYMENT_TTL_MINUTES=10
# Hours after which an unlocked table locks QR ordering again (default 12)
TABLE_AUTO_RELEASE_HOURS=12
# SMTP (invoice emails)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SERVER_PORT=
# Comma-separated allowed frontend origins; "*" works as a wildcard, e.g.
# https://pos-cafe.vercel.app,https://pos-cafe-*.vercel.app
# Leave empty only for local development (allows every origin).
CORS_ORIGIN=
